# Airflow stack environment variables.
# Copy to .env in the same folder and fill with your actual values.
#
# These values are passed through Docker Compose to the Airflow containers,
# which makes them available as os.getenv() inside DAG tasks.

# Snowflake — same values as your project root .env
SNOWFLAKE_ACCOUNT=LQZIGNN-AJC44234
SNOWFLAKE_USER=LACHU76
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=ABC_BANK_ANALYTICS

# dbt-specific (separate role/warehouse for least-privilege execution)
SNOWFLAKE_DBT_ROLE=DBT_ROLE
SNOWFLAKE_DBT_WAREHOUSE=DBT_WH

# PII tokenization (must match the salt used during ingestion!)
PII_SALT=replace_with_your_actual_salt
